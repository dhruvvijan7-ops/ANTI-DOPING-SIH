# =============================================================================
# VERITY — environment configuration
# Copy to `.env` and adjust. NEVER commit real `.env` values.
# =============================================================================

# --- Application ---
APP_ENV=development
DEBUG=true

# --- PostgreSQL ---
POSTGRES_USER=clean_sport
POSTGRES_PASSWORD=clean_sport
POSTGRES_DB=clean_sport
# Host port to expose PostgreSQL on. Change if 5432 is already in use locally.
POSTGRES_HOST_PORT=54320

# Backend uses this when run outside Docker (local dev). In Docker Compose the
# connection string is constructed from POSTGRES_* above.
# DATABASE_URL=postgresql+psycopg://clean_sport:clean_sport@localhost:54320/clean_sport

# --- Backend server ---
BACKEND_PORT=8000
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Security: CHANGE THESE in any real deployment ---
JWT_SECRET_KEY=change-me-in-production-and-keep-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Development seed ---
DEPLOY_INITIAL_USERS=true
INITIAL_ADMIN_PASSWORD=ChangeMeAdmin123!

# --- Frontend ---
FRONTEND_PORT=8080
# Base URL the frontend uses for API calls when served.
VITE_API_BASE_URL=http://localhost:8000/api/v1
