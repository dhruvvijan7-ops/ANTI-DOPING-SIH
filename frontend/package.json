{
  "name": "verity-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "VERITY — Anti-Doping Intelligence & Investigations Platform (frontend)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.16",
